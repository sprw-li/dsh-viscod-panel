{
  "name": "@local/viscod-panel",
  "version": "0.1.0",
  "private": true,
  "description": "Viscod 项目思维导图：在 DSH 边栏打开当前项目的可协同思维导图面板",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
